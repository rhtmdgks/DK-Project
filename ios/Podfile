# Uncomment this line to define a global platform for your project (home_widget requires 14.0+)
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# flutter pub get 후에는 반드시 `cd ios && pod install` 을 실행하세요.
# (GeneratedPluginRegistrant 에서 app_links ObjC 참조를 제거하고 AppDelegate.swift 에서 등록합니다.)

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# app_links 는 Swift 전용 플러그인이라 ObjC GeneratedPluginRegistrant 에서 @import 하면
# Xcode 환경마다 모듈/헤더 경로가 깨지기 쉬움 → import·등록 줄을 제거하고 AppDelegate.swift 에서만 등록.
def strip_app_links_from_objc_registrant!
  path = File.join(__dir__, 'Runner', 'GeneratedPluginRegistrant.m')
  return unless File.file?(path)

  contents = File.read(path)
  original = contents.dup

  contents.gsub!(
    %r{(?:^\s*//[^\n]*\n)*^\s*#if __has_include\(<app_links[\s\S]*?^\s*#endif\s*\n}m,
    "// app_links: ObjC 미사용 — Runner/AppDelegate.swift 에서 등록\n",
  )
  contents.gsub!(
    %r{^\s*\[AppLinksIosPlugin registerWithRegistrar:\[registry registrarForPlugin:@"AppLinksIosPlugin"\]\];\s*\n}m,
    '',
  )

  if contents.match?(/@import app_links\b|\[AppLinksIosPlugin|#if __has_include\(<app_links/)
    STDERR.puts '[Podfile] 경고: GeneratedPluginRegistrant.m 에 app_links ObjC 참조가 남았습니다.'
  end

  return if contents == original

  File.write(path, contents)
  STDERR.puts '[Podfile] GeneratedPluginRegistrant.m: app_links ObjC 블록 제거 완료'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
  strip_app_links_from_objc_registrant!
end
