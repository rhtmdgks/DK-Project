# Uncomment this line to define a global platform for your project (home_widget requires 14.0+)
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # 동적 프레임워크만 쓰면 GeneratedPluginRegistrant 의 @import app_links 등에서 모듈을 못 찾는 경우가 있음
  use_frameworks! :linkage => :static
  # Swift 플러그인(app_links 등) 모듈 맵을 ObjC Runner 가 찾도록
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

def patch_app_links_generated_plugin_registrant!
  path = File.join(__dir__, 'Runner', 'GeneratedPluginRegistrant.m')
  return unless File.file?(path)

  contents = File.read(path)
  # Pods-Runner.xcconfig 의 HEADER_SEARCH_PATH 는 …/app_links.framework/Headers 이므로
  # 실제 파일명은 <app_links-Swift.h> (중첩 app_links/ 경로 아님).
  replacement = <<~'PATCH'.strip
// Swift 전용 app_links (pod install 시 재적용 — flutter pub get 이 원복함)
#if __has_include(<app_links-Swift.h>)
#import <app_links-Swift.h>
#elif __has_include(<app_links/app_links-Swift.h>)
#import <app_links/app_links-Swift.h>
#elif __has_include(<app_links/AppLinksIosPlugin.h>)
#import <app_links/AppLinksIosPlugin.h>
#else
@import app_links;
#endif
PATCH

  return if contents.include?('#if __has_include(<app_links-Swift.h>)')

  vanilla = <<~'PATCH'.strip
#if __has_include(<app_links/AppLinksIosPlugin.h>)
#import <app_links/AppLinksIosPlugin.h>
#else
@import app_links;
#endif
PATCH

  legacy_patch = <<~'PATCH'.strip
// Swift 전용 app_links: 생성 헤더 우선 (flutter pub get 이 덮어쓰므로 pod install 시 재적용)
#if __has_include(<app_links/app_links-Swift.h>)
#import <app_links/app_links-Swift.h>
#elif __has_include(<app_links/AppLinksIosPlugin.h>)
#import <app_links/AppLinksIosPlugin.h>
#else
@import app_links;
#endif
PATCH

  if contents.include?(legacy_patch)
    File.write(path, contents.sub(legacy_patch, replacement))
    STDERR.puts '[Podfile] GeneratedPluginRegistrant.m: app_links 헤더를 <app_links-Swift.h> 로 수정'
  elsif contents.include?(vanilla)
    File.write(path, contents.sub(vanilla, replacement))
    STDERR.puts '[Podfile] GeneratedPluginRegistrant.m: app_links Swift 헤더 분기 적용됨'
  else
    STDERR.puts '[Podfile] GeneratedPluginRegistrant.m: app_links 블록을 찾지 못했습니다.'
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
  patch_app_links_generated_plugin_registrant!
end
