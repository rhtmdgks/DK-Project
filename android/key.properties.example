# Google Play에 등록한 업로드 키로 서명합니다.
# 이 파일을 복사해 key.properties 로 저장하고 값만 채운 뒤 절대 커밋하지 마세요.
#
# 새 업로드 키가 필요하면 (문서: Use Play App Signing — answer 9842756):
#   1) android/scripts/create_upload_keystore.sh 실행 → .jks + *_certificate.pem 생성
#   2) 기존 키 분실 시: Play Console에서 계정 소유자가「업로드 키 재설정」요청 후 PEM 제출
#   3) 승인되면 아래 storeFile·비밀번호·alias 를 그 키스토어에 맞게 설정
#
# storeFile 은 android 폴더 기준 상대 경로 권장
#   예: app/upload-keystore.jks  또는  app/upload-keystore.p12 (OpenSSL로 생성한 경우)
#
# 대안: 환경 변수만 설정해도 됩니다 (CI 등).
#   ANDROID_UPLOAD_STORE_FILE=/절대경로/upload-keystore.jks
#   ANDROID_UPLOAD_STORE_PASSWORD=...
#   ANDROID_UPLOAD_KEY_ALIAS=...
#   ANDROID_UPLOAD_KEY_PASSWORD=...
#
# Play 업로드 없이 Release만 디버그 키로 빌드하려면 android/gradle.properties 에
#   android.signReleaseWithDebug=true
# 또는 환경 변수 ANDROID_SIGN_RELEASE_WITH_DEBUG=1 (Play 업로드 불가).
#
# 업로드 키가 Play와 같은지 확인 (출력 SHA1 이 아래와 같아야 함 — upload_cert.der 과 동일):
#   keytool -list -v -keystore app/upload-keystore.jks -alias <별칭>
#   SHA1: 2A:C4:EE:19:FD:D0:A6:FA:87:15:06:A0:26:14:50:A4:9B:FA:E0:F2

storePassword=변경하세요
keyPassword=변경하세요
keyAlias=업로드키_별칭
storeFile=app/upload-keystore.jks
